API_KEY=engineering-department-api-key-2025
API_GATEWAY_URL=http://host.docker.internal:4000
LOG_LEVEL=DEBUG
PORT=8080

# ==========================================
# ⚡ Wheeling Charges (ค่าผ่านทาง THB/kWh)
# ==========================================
WHEELING_INTRA_ZONE=0.50      # ภายในโซนเดียวกัน
WHEELING_ADJACENT_ZONE=1.00   # ข้ามโซนติดกัน (<2km)
WHEELING_CROSS_ZONE=1.50      # ข้ามโซนระยะกลาง (2-5km)
WHEELING_REMOTE_ZONE=2.00     # ข้ามโซนระยะไกล (>5km)

# ==========================================
# 🔌 Technical Losses (ค่าสูญเสียในระบบ %)
# ==========================================
LOSS_INTRA_ZONE=0.01          # 1%
LOSS_ADJACENT_ZONE=0.02       # 2%
LOSS_CROSS_ZONE=0.04          # 4%
LOSS_REMOTE_ZONE=0.06         # 6%
DEV_MODE=true
NUM_METERS=100
PORT=8080

# Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=meter-readings
