# Frontend (Next.js) environment — copy to .env.local for local dev.

# Backend simulator base URL. The Next.js server proxies /api/v1/* to this
# (see next.config.ts rewrites). The browser never calls it directly, so it
# only needs to be reachable from the Next.js server, not from the client.
#
# Local dev (default if unset): http://localhost:8082
# Vercel: set SIMULATOR_URL in Project Settings -> Environment Variables to the
#         public URL of your deployed backend, e.g. https://sim-backend.fly.dev
SIMULATOR_URL=http://localhost:8082

# Mapbox token for the map view (client-side; must be NEXT_PUBLIC_).
NEXT_PUBLIC_MAPBOX_TOKEN=
