SIMULATION_INTERVAL=15
NUM_METERS=80
OUTPUT_FILE=./data/meter_readings.jsonl
AUTOSTART_SIMULATION=true

GRID_TOPOLOGY=glm:src/smart_meter_simulator/data/grids/grid_bus_network.glm

SOLAR_PANEL_EFFICIENCY_MIN=0.85
SOLAR_PANEL_EFFICIENCY_MAX=0.95
BASE_GENERATION_MIN=2.0
BASE_GENERATION_MAX=7.0
PV_MODEL_ENABLED=true
PV_SURFACE_TILT_DEG=15.0
PV_SURFACE_AZIMUTH_DEG=180.0
PV_TEMPERATURE_COEFFICIENT=-0.003
PV_DC_AC_RATIO=1.10
PV_ON_EVERY_BUS=true
BUS_PV_CAPACITY_MIN_KW=10.0
BUS_PV_CAPACITY_MAX_KW=10.0
# IEEE 1547 volt-watt: PV inverters curtail real-power export as the local bus
# voltage rises — full export below V_START (pu), zero export at V_END (pu).
PV_VOLTWATT_ENABLED=true
PV_VOLTWATT_V_START=1.06
PV_VOLTWATT_V_END=1.10
PV_VOLTWATT_MAX_ITER=5
# Frequency-watt droop: system frequency = NOMINAL + FULL_SWING * imbalance ratio
# (gen-load normalized to [-1,1]); meters throttle export under over-frequency.
FREQ_DROOP_ENABLED=true
FREQ_NOMINAL_HZ=50.0
FREQ_FULL_SWING_HZ=0.5
BASE_CONSUMPTION_MIN=0.5
BASE_CONSUMPTION_MAX=3.0
NOISE_FACTOR_MIN=0.05
NOISE_FACTOR_MAX=0.15
ZIP_IMPEDANCE_FRACTION=0.20
ZIP_CURRENT_FRACTION=0.30
ZIP_POWER_FRACTION=0.50

LINE_LENGTH_UNIT=ft
# Realistic 0.4 kV LV trunk (240 mm^2 Al): sized so the feeder carries its load
# and the exact power-flow (pandapower bfsw) converges. Ampacity ~420 A.
LINE_RESISTANCE_OHM_PER_KM=0.125
LINE_REACTANCE_OHM_PER_KM=0.08
LINE_CAPACITY_KW=500.0
LINE_AMPACITY_KA=0.42

# MV/LV distribution transformer feeding the substation bus (22 kV -> 0.4 kV).
# Models a real upstream transformer with impedance + iron/copper losses, so the
# LV bus voltage sags under load and rises on PV backfeed across it instead of a
# stiff 1.0 pu source. Disable for an ideal LV slack. 630 kVA, 4% impedance.
TRANSFORMER_ENABLED=true
TRANSFORMER_MV_KV=22.0
TRANSFORMER_SN_MVA=0.63
TRANSFORMER_VK_PERCENT=4.0
TRANSFORMER_VKR_PERCENT=1.2
TRANSFORMER_PFE_KW=1.0
TRANSFORMER_I0_PERCENT=0.3
# On-load tap changer: steps the HV tap each tick to hold the LV feeder head at
# V_TARGET (pu) within DEADBAND, before volt-watt curtailment kicks in.
TRANSFORMER_OLTC_ENABLED=true
TRANSFORMER_TAP_STEP_PERCENT=1.25
TRANSFORMER_TAP_MAX=8
TRANSFORMER_OLTC_V_TARGET=1.0
TRANSFORMER_OLTC_DEADBAND=0.0125
TRANSFORMER_OLTC_MAX_STEPS=10

SOLAR_PROSUMER_RATIO=0.25
GRID_CONSUMER_RATIO=0.50
HYBRID_PROSUMER_RATIO=0.15

WEATHER_SUNNY_WEIGHT=0.4
WEATHER_PARTLY_CLOUDY_WEIGHT=0.3
WEATHER_CLOUDY_WEIGHT=0.15
WEATHER_OVERCAST_WEIGHT=0.1
WEATHER_RAINY_WEIGHT=0.05

LOG_LEVEL=INFO
METRICS_PORT=9091
SIMULATION_SPEED_MULTIPLIER=1.0
RANDOM_SEED=42
WEATHER_CHANGE_FREQUENCY=5
BASE_LATITUDE=13.758252
BASE_LONGITUDE=100.687455
# IANA timezone for the grid location; PV generation tracks local solar noon.
TIMEZONE=Asia/Bangkok
MIN_LOAD_KW=0.1
MAX_LOAD_KW=500.0

# DLMS/COSEM (IEC 62056) REST egress to the Oracle Bridge ingest endpoint
# (ORACLE_BRIDGE_URL above). Off by default; signs each reading per-meter and
# registers pubkeys in Redis (REDIS_URL) on start.
ORACLE_DLMS_ENABLED=false
ORACLE_DLMS_EMIT_EVERY=1
# Static meter->owner map (JSON {meter_id: user_id}) seeded into the bridge's
# Redis registry so telemetry resolves to a user_id for settlement. Without an
# entry the bridge resolves to Uuid::nil and skips settlement.
# ORACLE_METER_OWNER_MAP={"METER-001":"00000000-0000-0000-0000-000000000001"}
# When true, the engine onboards each meter to IAM (register->login->claim) at
# start and uses the resulting user_ids as the owner map (merged over the static
# map above). Non-fatal; needs the IAM gateway reachable at IAM_GATEWAY_URL.
ORACLE_IAM_ONBOARD_ENABLED=false
IAM_GATEWAY_URL=http://localhost:4001

# PostGIS persistence: batch-insert each tick's readings into grid.meter_readings
# and upsert the meter population into grid.meters on start (geo asset schema in
# database/migrations/). Enables replay/history + geo queries. Off by default;
# writer is non-blocking and drops a tick if the prior batch is still in flight.
POSTGIS_ENABLED=false
POSTGIS_URL=postgresql://gridtokenx_user:gridtokenx_password@localhost:7001/gridtokenx
POSTGIS_PERSIST_EVERY=1
