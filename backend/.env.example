SIMULATION_INTERVAL=15
NUM_METERS=5
OUTPUT_FILE=./data/meter_readings.jsonl

# =============================================================================
# Database (PostgreSQL + PostGIS)
# =============================================================================
# Primary Database - GridTokenX API (users, trading, orders)
DATABASE_URL=postgresql+asyncpg://gridtokenx:gridtokenx_password@localhost:5432/gridtokenx
DATABASE_SYNC_URL=postgresql://gridtokenx:gridtokenx_password@localhost:5432/gridtokenx

# GIS Database - Spatial Data (grid topology, meters, locations)
GIS_DATABASE_URL=postgresql+asyncpg://gridtokenx:gridtokenx_password@localhost:5433/gridtokenx_gis
ENABLE_POSTGIS=true

# =============================================================================
# Redis (Caching & Pub/Sub)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# =============================================================================
# Kafka (Event Streaming)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=meter_readings

# =============================================================================
# API Gateway
# =============================================================================
API_GATEWAY_URL=http://localhost:4000
API_KEY=your-api-key

# =============================================================================
# Transport Configuration
# =============================================================================
# Transport type: grpc, http, kafka, mqtt
TRANSPORT_TYPE=grpc
# Oracle Bridge gRPC endpoint
GRPC_GATEWAY_HOST=localhost
GRPC_GATEWAY_PORT=50051

# =============================================================================
# InfluxDB (Time-Series Data)
# =============================================================================
INFLUXDB_URL=http://gridtokenx-influxdb:8086
INFLUXDB_TOKEN=admin_token
INFLUXDB_ORG=gridtokenx
INFLUXDB_BUCKET=meter_readings

# =============================================================================
# WebSocket
# =============================================================================
WS_ENABLED=true
WS_HOST=localhost
WS_PORT=8765
SOLAR_PANEL_EFFICIENCY_MIN=0.85
SOLAR_PANEL_EFFICIENCY_MAX=0.95
BASE_GENERATION_MIN=3.0
BASE_GENERATION_MAX=15.0
BASE_CONSUMPTION_MIN=1.5
BASE_CONSUMPTION_MAX=8.0
NOISE_FACTOR_MIN=0.05
NOISE_FACTOR_MAX=0.15
MIN_SELL_PRICE=0.15
MAX_SELL_PRICE=0.35
MIN_BUY_PRICE=0.20
MAX_BUY_PRICE=0.40
GRID_FEED_IN_RATE=0.12
GRID_PURCHASE_RATE=0.28
WEATHER_SUNNY_WEIGHT=0.4
WEATHER_PARTLY_CLOUDY_WEIGHT=0.3
WEATHER_CLOUDY_WEIGHT=0.15
WEATHER_OVERCAST_WEIGHT=0.1
WEATHER_RAINY_WEIGHT=0.05
BATTERY_CAPACITY_MIN=10.0
BATTERY_CAPACITY_MAX=30.0
BATTERY_EFFICIENCY_MIN=0.90
BATTERY_EFFICIENCY_MAX=0.95
SOLAR_PROSUMER_RATIO=0.40
GRID_CONSUMER_RATIO=0.35
HYBRID_PROSUMER_RATIO=0.20
BATTERY_STORAGE_RATIO=0.05
EV_CHARGER_RATIO=0.00
UNIVERSITY_VALIDATOR_ENDPOINT=http://localhost:8899
ENGINEERING_DEPT_AUTHORITY=true
REC_CERTIFICATION_ENABLED=true
CARBON_OFFSET_RATE=0.7
WS_ENABLED=true
WS_HOST=localhost
WS_PORT=8765
LOG_LEVEL=INFO
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=60
PROMETHEUS_METRICS_ENABLED=true
SIMULATION_SPEED_MULTIPLIER=1.0
RANDOM_SEED=42
WEATHER_CHANGE_FREQUENCY=5
ENABLE_MARKET_DYNAMICS=true
VITE_MAPBOX_ACCESS_TOKEN=
VITE_API_URL=http://localhost:8082
