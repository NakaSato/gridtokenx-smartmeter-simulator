// GridTokenX per-node PV systems for GridLAB-D simulation
// One 10 kW inverter + solar object is attached to each GLM meter/node.
// Every node has the same PV capacity for GridLAB-D simulation.

object inverter {
    name "PV_Inverter_ref_lv_bus_4";
    parent "ref_lv_bus_4";
    phases ABCN;
    generator_status ONLINE;
    generator_mode SUPPLY_DRIVEN;
    inverter_type FOUR_QUADRANT;
    four_quadrant_control_mode CONSTANT_PF;
    rated_power 10000.0;
    inverter_efficiency 0.96;
    power_factor 1.0;
}

object solar {
    name "PV_ref_lv_bus_4";
    parent "PV_Inverter_ref_lv_bus_4";
    phases ABCN;
    generator_mode SUPPLY_DRIVEN;
    generator_status ONLINE;
    panel_type SINGLE_CRYSTAL_SILICON;
    SOLAR_POWER_MODEL FLATPLATE;
    SOLAR_TILT_MODEL SOLPOS;
    orientation FIXED_AXIS;
    tilt_angle 15.0;
    orientation_azimuth 180.0;
    efficiency 0.20;
    area 538.20 sf; // 10.000 kW at 1000 W/m2
}

